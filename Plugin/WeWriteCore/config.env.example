# =============================================================================
# WeWriteCore — shared environment for WeWriteRender / WeWritePublish /
# WeWriteThemes (and future WeWrite* plugins).
#
# These variables are read by Plugin/WeWriteCore/bootstrap.py and rendered
# into wewrite/config.yaml + wewrite/style.yaml at runtime, so the embedded
# wewrite source stays unmodified.
#
# Copy this file into each WeWrite* plugin directory as `config.env` and
# fill in the values, OR set them globally in the parent VCP env.
# =============================================================================

# ---- 微信公众号 API (推送草稿箱时必需) ---------------------------------------
# 获取地址: https://mp.weixin.qq.com → 设置与开发 → 基本配置
WECHAT_APPID=
WECHAT_SECRET=
# 默认作者署名 (可选)
WECHAT_AUTHOR=

# ---- 排版默认主题 ------------------------------------------------------------
# 16+ 内置主题之一: professional-clean (默认) / minimal / newspaper /
# tech-modern / bytedance / github / warm-editorial / sspai / ink /
# elegant-rose / bold-navy / minimal-gold / bold-green / bauhaus /
# focus-red / midnight
WEWRITE_DEFAULT_THEME=professional-clean

# ---- 公众号风格画像 (Step 1 onboard 的等价配置) -----------------------------
# 公众号名称
WEWRITE_NAME=VCP公众号
# 所属行业 / 领域
WEWRITE_INDUSTRY=科技/互联网
# 目标读者画像 (可选)
WEWRITE_TARGET_AUDIENCE=
# 选题方向, 逗号分隔
WEWRITE_TOPICS=AI/人工智能,效率工具
# 整体语气
WEWRITE_TONE=专业但不学术，有观点但不偏激，偶尔幽默
# 叙事人称
WEWRITE_VOICE=第一人称，像一个懂行的朋友在分享见解
# 推荐字数区间
WEWRITE_WORD_COUNT=1500-2500
# 内容风格: 干货 / 故事 / 情绪 / 热点 / 测评
WEWRITE_CONTENT_STYLE=干货
# 写作人格 (5 选 1):
#   midnight-friend  深夜好友, 极度口语化, 个人号/自媒体
#   warm-editor      温暖编辑, 故事+情感, 生活/文化
#   industry-observer 行业观察, 中性分析, 行业媒体
#   sharp-journalist 犀利记者, 短句强观点, 新闻/评论
#   cold-analyst     冷静分析师, 数据驱动, 财经/投研
WEWRITE_WRITING_PERSONA=midnight-friend
# 文章署名 (覆盖 WECHAT_AUTHOR, 也可作为 style.yaml.author)
WEWRITE_AUTHOR=
# 封面整体风格描述 (供生图插件参考)
WEWRITE_COVER_STYLE=简洁封面，主体明确
# 禁用词, 逗号分隔
WEWRITE_BLACKLIST_WORDS=震惊,必看,不转不是中国人,赶紧收藏
# 禁忌话题, 逗号分隔
WEWRITE_BLACKLIST_TOPICS=政治敏感,宗教,色情,赌博
# 参考账号, 逗号分隔 (仅文档用途, 不会触发抓取)
WEWRITE_REFERENCE_ACCOUNTS=
