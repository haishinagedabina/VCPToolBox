# StockScreener 插件配置模板
# 复制为 config.env 后填入真实值（config.env 不应提交到仓库）

# DSA(daily_stock_analysis) 的 SQLite 数据库绝对路径
# DSA 在 Docker 中运行，但其 docker-compose 用 bind mount 将容器内
# /app/data 绑定到宿主机的 daily_stock_analysis/data 目录，因此数据库文件
# 物理上就在宿主机这个路径，本插件在宿主机原生运行可直接读取。
# 对应 docker/docker-compose.yml: "../data:/app/data"
STOCK_DB_PATH=E:/daily_stock_analysis/data/stock_analysis.db

# 只读连接的 busy_timeout（秒），用于规避 DSA 写库期间的锁等待，可选，默认 5
STOCK_DB_TIMEOUT=5

# ── 板块锁定选股触发（trigger_board_run 命令用，写/触发） ──
# DSA 服务基址，用于 POST {DSA_API_BASE_URL}/api/v1/screening/runs（stock_codes 限定宇宙）。
# 不配置则 trigger_board_run 报配置错误，其余只读命令不受影响。
DSA_API_BASE_URL=http://127.0.0.1:8000

# 触发请求超时（秒）。选股是同步阻塞调用(DSA跑完才返回)，需大于一次选股耗时(约2-4分钟)，
# 且必须小于插件 communication.timeout(600000ms=600s)。默认 540。
DSA_API_TIMEOUT=540

# 可选：DSA 启用登录鉴权时携带的 Cookie（如 session=xxx）。未启用鉴权可留空。
DSA_API_COOKIE=
