# --- WeWriteFetchArticle config example ---
# Copy to config.env and edit. Only effective when this plugin is enabled
# in VCP.

# requests-level timeout (seconds). Camoufox / Playwright have their own
# internal timeouts and are not affected by this value.
# Default: 25
WEWRITE_FETCH_TIMEOUT=25

# Allow this plugin to honour HTTP(S)_PROXY env vars inherited from the
# parent process. By default WeWriteCore strips them because WeChat APIs
# require IP-whitelisted outbound. Fetching public articles is usually
# fine without a proxy, but turn this on if your DNS is blocking
# mp.weixin.qq.com or you must go through a corporate proxy.
# Default: false (set to "true" to enable)
# WEWRITE_ALLOW_PROXY=true
