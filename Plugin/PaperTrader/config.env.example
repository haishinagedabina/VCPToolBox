# PaperTrader 插件配置模板
# 复制为 config.env 后填入真实值（config.env 不应提交到仓库）

# DSA(daily_stock_analysis) 的 SQLite 数据库绝对路径（只读，用于取日线行情做模拟成交）
STOCK_DB_PATH=E:/daily_stock_analysis/data/stock_analysis.db

# 模拟盘账本数据库路径（本插件读写，自动创建）。建议放在插件目录下。
PAPER_DB_PATH=E:/VCPChat/VCPToolBox/Plugin/PaperTrader/paper_portfolio.db

# 每个持仓的模拟分配资金（用于计算份额与盈亏金额），默认 100000
POSITION_CAPITAL=100000

# 最多同时追踪的持仓数（含待触发 watching 仓），默认 3
MAX_SLOTS=3

# 只读连接 busy_timeout（秒），默认 5
STOCK_DB_TIMEOUT=5
